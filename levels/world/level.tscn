[node name="Note_Workshop" type="StaticBody3D" parent="Notes" unique_id=331597461]
transform = Transform3D(0.17364822, 0, 0.9848077, 0, 1, 0, -0.9848077, 0, 0.17364822, 11.45, 1.36, -27.5)
script = ExtResource("13_l5lfc")
note_id = "workshop"
title = "Памятка в мастерской"
text = "Засов на двери мастерской поставил от детей — чтобы не лезли к инструментам.

Держит крепко. Задвинул снаружи — изнутри уже не открыть. Разве что выломать, но на это уйдёт время."

[node name="Paper" type="MeshInstance3D" parent="Notes/Note_Workshop" unique_id=874427730]
material_override = SubResource("StandardMaterial3D_7jqyl")
mesh = SubResource("BoxMesh_xl7j7")

[node name="Shape" type="CollisionShape3D" parent="Notes/Note_Workshop" unique_id=524989567]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.05, 0)
shape = SubResource("BoxShape3D_o0wo3")

[node name="Note_Sister" type="StaticBody3D" parent="Notes" unique_id=694965798]
transform = Transform3D(0.9659258, 0, -0.25881904, 0, 1, 0, 0.25881904, 0, 0.9659258, 10.6, 4.21, -17)
script = ExtResource("13_l5lfc")
note_id = "sister"
title = "Письмо сестры (не отправлено)"
text = "Хит,

это уже третье письмо за месяц, и я знаю, что ты их читаешь.

Папа не скажет этого сам, но он каждый вечер спрашивает, не звонил ли ты. Он постарел. Он был неправ во многом — и ты тоже.

Приезжай на Новый год. Пожалуйста. Просто сядь с нами за стол.

Дети тебя почти не помнят, но рисуют тебя на каждом рисунке."

[node name="Paper" type="MeshInstance3D" parent="Notes/Note_Sister" unique_id=726731204]
material_override = SubResource("StandardMaterial3D_7jqyl")
mesh = SubResource("BoxMesh_kdsbj")

[node name="Shape" type="CollisionShape3D" parent="Notes/Note_Sister" unique_id=1572477104]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.05, 0)
shape = SubResource("BoxShape3D_u5n7q")

[node name="Note_Diary" type="StaticBody3D" parent="Notes" unique_id=1109972370]
transform = Transform3D(0.9396926, 0, 0.34202012, 0, 1, 0, -0.34202012, 0, 0.9396926, -7.2, 4.21, -26)
script = ExtResource("13_l5lfc")
note_id = "diary"
title = "Дневник бабушки"
text = "12 ноября. Сосед опять принёс дрова. Третий раз за неделю. Денег не берёт.

3 декабря. Чинил крыльцо. Долго стоял в подвале — сказал, смотрит трубы. Спрашивал, приедет ли наш мальчик на праздник. Зачем ему это?

27 декабря. Он знает дом лучше нас. Сегодня я видела, как он считал окна.

30 декабря. Сказала мужу. Он смеётся: «Хороший человек, мать». Я заперла дверь на ночь."

[node name="Paper" type="MeshInstance3D" parent="Notes/Note_Diary" unique_id=1751281366]
material_override = SubResource("StandardMaterial3D_7jqyl")
mesh = SubResource("BoxMesh_qslh7")

[node name="Shape" type="CollisionShape3D" parent="Notes/Note_Diary" unique_id=1719186042]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.05, 0)
shape = SubResource("BoxShape3D_krw8e")

[node name="Note_Clipping" type="StaticBody3D" parent="Notes" unique_id=440787721]
transform = Transform3D(0.8660254, 0, 0.5, 0, 1, 0, -0.5, 0, 0.8660254, 6.4, -1.74, -23.3)
script = ExtResource("13_l5lfc")
note_id = "clipping"
title = "Газетная вырезка"
text = "ВЕСТНИК ДОЛИНЫ, 4 января

СЕМЬЯ ХАРРОУ ПОКИНУЛА ДОЛИНУ

Дом Харроу найден пустым утром первого января. Праздничный стол накрыт, вещи на местах. Шериф считает, что семья уехала к родственникам.

Старший сын Харроу, пять лет назад порвавший с семьёй, приезжал на праздник. Его автомобиль найден на лесной дороге.

Это третий подобный случай за девять лет."
kind = "print"


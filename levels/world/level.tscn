text = "ДОСТАВКА ИЗ ГОРОДА
30 декабря

Мука, масло, свечи ............ 12 шт.
Индейка ........................ 1
Керосин ........................ 2 л

Получатель: Лоун

Пометка курьера на обороте:
«Сын приезжает 31-го, к вечеру. Один. Передал.»"
kind = "print"

[node name="Paper" type="MeshInstance3D" parent="Notes/Note_Receipt" unique_id=700397903]

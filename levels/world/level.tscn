[node name="Note_Father" type="StaticBody3D" parent="Notes" unique_id=960467869]
transform = Transform3D(0.9961947, 0, 0.08715574, 0, 1, 0, -0.08715574, 0, 0.9961947, 7, 1.215, -14.05)
script = ExtResource("13_l5lfc")
note_id = "father_note"
title = "Записка отца"
text = "Код от сейфа я опять забыл бы, если бы не дети.

Они нарисовали по цифре — каждый своим мелком — и растащили рисунки по дому. На дверце я наклеил четыре цветные метки: в каком порядке читать.

Если со мной что-то случится — ключ от подвала в сейфе. И ещё кое-что. Для Хита."

[node name="Paper" type="MeshInstance3D" parent="Notes/Note_Father" unique_id=571306334]
material_override = SubResource("StandardMaterial3D_7jqyl")
mesh = SubResource("BoxMesh_b7y0n")

[node name="Shape" type="CollisionShape3D" parent="Notes/Note_Father" unique_id=854370272]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.05, 0)
